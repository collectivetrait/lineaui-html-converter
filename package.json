{
  "name": "@collectivetrait/lineaui-html-converter",
  "version": "0.1.0",
  "private": true,
  "description": "Converts visual designs into pixel-perfect Linea UI implementations.",
  "dependencies": {
    "@collectivetrait/lineaui": "latest",
    "@collectivetrait/lineaui-reference": "latest",
    "browser-sync": "^3.0.0",
    "sass": "^1.80.0"
  },
  "scripts": {
    "compile": "npx sass output/assets/styles/styles.scss output/assets/styles/styles.css --no-source-map",
    "watch": "npx sass --watch output/assets/styles/styles.scss output/assets/styles/styles.css --no-source-map",
    "serve": "npx browser-sync start --server 'output' --files 'output/index.html, output/assets/styles/styles.css, output/assets/scripts/main.js' --no-open",
    "dev": "npm run watch & npm run serve"
  }
}
